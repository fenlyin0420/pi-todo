{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Node16",
		"moduleResolution": "Node16",
		"lib": [
			"ES2022"
		],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"types": [
			"node"
		],
		"paths": {
			"@juicesharp/rpiv-test-utils": [
				"./test-utils/index.ts"
			]
		}
	},
	"include": [
		"**/*.ts"
	],
	"exclude": [
		"node_modules",
		"docs"
	]
}
