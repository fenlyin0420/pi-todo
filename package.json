{
	"name": "@juicesharp/rpiv-todo",
	"version": "2.13.9",
	"description": "Pi extension. A todo list for the model, rendered as a live overlay that survives /reload and conversation compaction.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"rpiv",
		"todo"
	],
	"type": "module",
	"license": "MIT",
	"author": "juicesharp",
	"contributors": [
		"fenlyin (https://github.com/fenlyin0420)"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fenlyin0420/pi-todo.git"
	},
	"homepage": "https://github.com/fenlyin0420/pi-todo#readme",
	"bugs": {
		"url": "https://github.com/fenlyin0420/pi-todo/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"format": "biome format --write .",
		"lint": "biome check --write .",
		"check": "npm run typecheck && npm run lint && npm test"
	},
	"files": [
		"config.ts",
		"index.ts",
		"locales/",
		"reminder.ts",
		"todo.ts",
		"todo-overlay.ts",
		"LICENSE",
		"docs/",
		"!docs/*.png",
		"!docs/*.jpg",
		"!docs/*.svg",
		"README.md",
		"state/invariants.ts",
		"state/i18n-bridge.ts",
		"state/replay.ts",
		"state/selectors.ts",
		"state/state-reducer.ts",
		"state/state.ts",
		"state/store.ts",
		"state/task-graph.ts",
		"tool/response-envelope.ts",
		"tool/sanitize.ts",
		"tool/types.ts",
		"view/format.ts"
	],
	"pi": {
		"image": "https://raw.githubusercontent.com/fenlyin0420/pi-todo/main/docs/cover.png",
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@juicesharp/rpiv-i18n": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@juicesharp/rpiv-i18n": {
			"optional": true
		}
	},
	"dependencies": {
		"@juicesharp/rpiv-config": "^2.13.9"
	},
	"overrides": {
		"@earendil-works/chord": "1.1.0",
		"@earendil-works/pi-agent-core": "1.1.0",
		"@earendil-works/pi-codemode": "1.1.0",
		"@earendil-works/pi-mcp": "1.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@earendil-works/pi-ai": "1.1.0",
		"@earendil-works/pi-coding-agent": "1.1.0",
		"@earendil-works/pi-tui": "1.1.0",
		"@juicesharp/rpiv-i18n": "2.13.9",
		"@types/node": "22.20.1",
		"typebox": "1.3.6",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	}
}
